@* Creates (Login not null: login is editable) or edits (Login null: the login is not changed) a player.
   Returns Values on save; the caller passes them to PlayerAdminService, which trims and validates again. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsCreate ? "Nový hráč" : "Upravit hráče")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            @if (IsCreate)
            {
                <MudTextField T="string" @bind-Value="_login" Label="Login" Variant="Variant.Outlined" Class="mb-3"
                              Required="true" RequiredError="Zadej login." />
            }
            <MudTextField T="string" @bind-Value="_nick" Label="Nick" Variant="Variant.Outlined" Class="mb-3"
                          Required="true" RequiredError="Zadej nick." MaxLength="AppUser.NickMaxLength"
                          Counter="AppUser.NickMaxLength" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Zrušit</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Uložit</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public sealed record Values(string Login, string Nick);

    private MudForm _form = default!;
    private string? _login;
    private string? _nick;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Login of a new player; null switches the dialog to editing an existing player.</summary>
    [Parameter]
    public string? Login { get; set; }

    [Parameter]
    public string Nick { get; set; } = string.Empty;

    private bool IsCreate => Login is not null;

    protected override void OnInitialized()
    {
        _login = Login;
        _nick = Nick;
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(new Values(
            _login?.Trim() ?? string.Empty,
            _nick?.Trim() ?? string.Empty)));
    }

    private void Cancel() => MudDialog.Cancel();
}
