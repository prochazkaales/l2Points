@inject IJSRuntime JS

@* Shows a generated password once. The password lives only in this dialog's parameters and is never logged. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Heslo účtu @Nick</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">Heslo se zobrazí jen teď. Předej ho majiteli účtu, později ho už neuvidíš.</MudText>
        <MudPaper Outlined="true" Class="pa-3">
            <MudText Typo="Typo.h6" Style="font-family: monospace; letter-spacing: 0.1em; user-select: all; overflow-wrap: anywhere;" Align="Align.Center">@Password</MudText>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync">Kopírovat</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Done">Hotovo</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Nick { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Password { get; set; } = string.Empty;

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
        }
        catch
        {
            // The clipboard may be unavailable (insecure context, denied permission); the password stays visible.
        }
    }

    private void Done() => MudDialog.Close(DialogResult.Ok(true));
}
