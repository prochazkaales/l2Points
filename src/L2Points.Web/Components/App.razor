<!DOCTYPE html>
<html lang="cs">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* SVG switches to its dark variant via prefers-color-scheme; PNG/ICO are the light variant for older browsers. *@
    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />
    <link rel="icon" href="@Assets["favicon-32.png"]" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    <meta name="theme-color" content="#4c2fb8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1726" media="(prefers-color-scheme: dark)" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["L2Points.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    @if (HttpContext.AcceptsInteractiveRouting())
    {
        @* Static placeholder for the time before the circuit connects (prerender is off); app.css hides it once the layout exists. *@
        <div class="l2p-loading" role="status">Načítám…</div>
    }
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <div id="blazor-error-ui" data-nosnippet>
        Došlo k neočekávané chybě.
        <a href="." class="reload">Načíst znovu</a>
        <span class="dismiss">🗙</span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/theme.js"]"></script>
    <script src="@Assets["js/scroll.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Prerendering is off: pages load their data once, over the circuit, instead of twice.
    private static readonly IComponentRenderMode InteractiveNoPrerender = new InteractiveServerRenderMode(prerender: false);

    // Account pages ([ExcludeFromInteractiveRouting]) are rendered statically because they set cookies.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveNoPrerender : null;
}
