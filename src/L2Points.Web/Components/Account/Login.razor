@page "/login"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager Navigation

<PageTitle>Přihlášení – L2Points</PageTitle>

<h1 class="account-title">Přihlášení</h1>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="account-error" role="alert">@_errorMessage</div>
}

<EditForm Model="Input" FormName="login" method="post" OnValidSubmit="LoginUserAsync" class="account-form">
    <DataAnnotationsValidator />

    <div class="account-field">
        <label for="login-username">Jméno</label>
        <InputText id="login-username" @bind-Value="Input.UserName" autocomplete="username" autofocus />
        <ValidationMessage For="() => Input.UserName" />
    </div>

    <div class="account-field">
        <label for="login-password">Heslo</label>
        <div class="account-password">
            <InputText id="login-password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
            <button type="button" class="account-password-toggle" data-l2p-password-toggle="login-password" aria-pressed="false" aria-label="Zobrazit heslo">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="account-eye-on" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/><path class="account-eye-off" d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>
            </button>
        </div>
        <ValidationMessage For="() => Input.Password" />
    </div>

    <label class="account-check">
        <InputCheckbox @bind-Value="Input.RememberMe" />
        <span>Zapamatovat</span>
    </label>

    <button type="submit" class="account-button">Přihlásit se</button>
</EditForm>

@code {
    private string? _errorMessage;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();

        // Already signed in (GET only; a form POST goes through the normal sign-in path).
        if (HttpMethods.IsGet(HttpContext.Request.Method) && HttpContext.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/", forceLoad: true);
        }
    }

    private async Task LoginUserAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(
            Input.UserName, Input.Password, Input.RememberMe, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Navigation.NavigateTo(IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/", forceLoad: true);
            return;
        }

        _errorMessage = result switch
        {
            { IsLockedOut: true } => "Účet je dočasně zablokován, zkus to za pár minut.",
            { IsNotAllowed: true } => "Účet je deaktivován.",
            _ => "Neplatné jméno nebo heslo.",
        };
    }

    // Only site-relative paths are accepted, so the login cannot be used as an open redirect.
    private static bool IsLocalUrl(string? url) =>
        !string.IsNullOrEmpty(url)
        && url[0] == '/'
        && (url.Length == 1 || (url[1] != '/' && url[1] != '\\'));

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Zadej jméno.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Zadej heslo.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
