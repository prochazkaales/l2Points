@page "/profile"
@layout AccountLayout
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager

<PageTitle>Profil – L2Points</PageTitle>

<h1 class="account-title">Změna hesla</h1>

@if (_succeeded)
{
    <div class="account-success" role="status">Heslo bylo změněno.</div>
}

@if (_errors.Count > 0)
{
    <div class="account-error" role="alert">
        @foreach (var error in _errors)
        {
            <div>@error</div>
        }
    </div>
}

<EditForm Model="Input" FormName="change-password" method="post" OnValidSubmit="ChangePasswordAsync" class="account-form">
    <DataAnnotationsValidator />

    <div class="account-field">
        <label for="cp-current">Současné heslo</label>
        <div class="account-password">
            <InputText id="cp-current" type="password" @bind-Value="Input.CurrentPassword" autocomplete="current-password" />
            <button type="button" class="account-password-toggle" data-l2p-password-toggle="cp-current" aria-pressed="false" aria-label="Zobrazit heslo">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="account-eye-on" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/><path class="account-eye-off" d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>
            </button>
        </div>
        <ValidationMessage For="() => Input.CurrentPassword" />
    </div>

    <div class="account-field">
        <label for="cp-new">Nové heslo</label>
        <div class="account-password">
            <InputText id="cp-new" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" />
            <button type="button" class="account-password-toggle" data-l2p-password-toggle="cp-new" aria-pressed="false" aria-label="Zobrazit heslo">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="account-eye-on" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/><path class="account-eye-off" d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>
            </button>
        </div>
        <ValidationMessage For="() => Input.NewPassword" />
    </div>

    <div class="account-field">
        <label for="cp-confirm">Nové heslo znovu</label>
        <div class="account-password">
            <InputText id="cp-confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            <button type="button" class="account-password-toggle" data-l2p-password-toggle="cp-confirm" aria-pressed="false" aria-label="Zobrazit heslo">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="account-eye-on" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/><path class="account-eye-off" d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>
            </button>
        </div>
        <ValidationMessage For="() => Input.ConfirmPassword" />
    </div>

    <button type="submit" class="account-button">Změnit heslo</button>
</EditForm>

<a href="/" class="account-link">Zpět do aplikace</a>

@code {
    private readonly List<string> _errors = [];
    private bool _succeeded;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ChangePasswordInput Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task ChangePasswordAsync()
    {
        _errors.Clear();
        _succeeded = false;

        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            _errors.Add("Uživatel nebyl nalezen, přihlas se znovu.");
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _errors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }

        // Changing the password rotates the security stamp; refresh the cookie to keep this session signed in.
        await SignInManager.RefreshSignInAsync(user);
        _succeeded = true;
        Input = new ChangePasswordInput();
    }

    private sealed class ChangePasswordInput
    {
        [Required(ErrorMessage = "Zadej současné heslo.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Zadej nové heslo.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Zopakuj nové heslo.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Hesla se neshodují.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
