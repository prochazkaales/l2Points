@page "/Error"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.Diagnostics

<PageTitle>Chyba – L2Points</PageTitle>

<h1 class="account-title">Chyba</h1>
<div class="account-error" role="alert">Při zpracování požadavku došlo k chybě.</div>

@if (ShowRequestId)
{
    <p class="account-muted">ID požadavku: <code>@RequestId</code></p>
}

<a href="/" class="account-link">Zpět do aplikace</a>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
