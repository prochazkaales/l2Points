@page "/week"
@using System.Globalization
@using L2Points.Domain.Stats
@using L2Points.Domain.Time
@using L2Points.Infrastructure.Services
@using L2Points.Web.Components.Attendance
@using L2Points.Web.Components.Stats
@using L2Points.Web.Formatting
@using WeekOverviewData = L2Points.Infrastructure.Services.WeekOverview
@inject OverviewService Overview
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject ILogger<WeekOverview> Logger
@implements IDisposable

<PageTitle>Týden – všichni – L2Points</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Týden – všichni</MudText>

<div class="mb-1">
    <WeekNavigator Week="_week" Today="_today" WeekChanged="OnWeekChanged" />
</div>

@* While another week loads, the current one stays on screen; only a thin progress line shows. *@
<div class="l2p-wk-loading mb-2">
    @if (_loading && _overview is not null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
    }
</div>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">Týden se nepodařilo načíst. Zkus to prosím znovu.</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">Zkusit znovu</MudButton>
}
else if (_overview is null || _summary is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else
{
    <div class="l2p-kpis mb-4">
        <KpiCard Label="Body party" Note="@PreviousWeekNote">@DisplayFormat.Points(_summary.WeekPoints)</KpiCard>
        <KpiCard Label="Účast party" Note="v týdnu">@DisplayFormat.Percent(_summary.WeekAttendance.Percent)</KpiCard>
        <KpiCard Label="Epiců s účastí" Note="@AverageNote">@_overview.Events.Count</KpiCard>
        @if (_summary.PlayersOfWeek.Count > 0)
        {
            var best = _summary.PlayersOfWeek[0];
            <KpiCard Label="Hráč týdne" ValueTitle="@string.Join(", ", _summary.PlayersOfWeek.Select(p => p.Nick))"
                     Note="@DisplayFormat.PointsCount(_summary.PlayersOfWeekPoints)">
                <MudLink Href="@DisplayFormat.PlayerUrl(best.UserId, _week)" Underline="Underline.Hover" Color="Color.Primary">@best.Nick</MudLink>
                @if (_summary.PlayersOfWeek.Count > 1)
                {
                    <span class="l2p-kpi-more">+@(_summary.PlayersOfWeek.Count - 1)</span>
                }
            </KpiCard>
        }
        else
        {
            <KpiCard Label="Hráč týdne" Note="zatím nikdo">–</KpiCard>
        }
    </div>

    <section class="mb-4">
        <div class="l2p-section-head">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="l2p-section-title">Hráči</MudText>
        </div>
        <MudPaper Outlined="true">
            <RankingTable Rows="_overview.Players" Ranks="_weekRanks" Jewels="_overview.Jewels" UserId="@_userId" Weekly="true" NickWeek="_week" />
        </MudPaper>
    </section>

    <section>
        <div class="l2p-section-head l2p-wk-events-head">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="l2p-section-title">Události týdne</MudText>
            @* A switch between the two views; the labels on both sides also pick a view. *@
            <div class="l2p-view-switch">
                <button type="button" class="@ViewLabelClass(EventView.Cards)" @onclick="() => _view = EventView.Cards">Karty</button>
                <MudSwitch T="bool" Value="@(_view == EventView.Grid)" ValueChanged="@(grid => _view = grid ? EventView.Grid : EventView.Cards)"
                           Color="Color.Primary" UncheckedColor="Color.Primary" AriaLabel="Zobrazit události jako mřížku" />
                <button type="button" class="@ViewLabelClass(EventView.Grid)" @onclick="() => _view = EventView.Grid">Mřížka</button>
            </div>
        </div>

        <MudPaper Outlined="true">
            <div class="l2p-wk-days">
                @foreach (var day in _week.Days)
                {
                    var count = EventsOn(day).Count;
                    <button type="button" class="@DayClass(day, count)" aria-pressed="@(day == _day ? "true" : "false")"
                            @onclick="() => _day = day">
                        <span>@DisplayFormat.DayHeader(day)</span>
                        <span class="l2p-wk-day-count">@count</span>
                    </button>
                }
            </div>

            @{
                var events = EventsOn(_day);
            }
            @if (events.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pa-4 l2p-wk-empty">@(_day > _today ? "Tento den ještě nenastal." : "Tento den nikdo nic nezapsal.")</MudText>
            }
            else if (_view == EventView.Cards)
            {
                <div class="l2p-wk-cards">
                    @foreach (var ev in events)
                    {
                        <MudPaper Outlined="true" Class="l2p-wk-card">
                            <div class="l2p-wk-card-top">
                                <span class="l2p-wk-time">@(DisplayFormat.EventTime(ev.Date, ev.TimeUtc) ?? "")</span>
                                @KindBadge(ev)
                            </div>
                            <div class="l2p-wk-card-title">@ev.Activity.Name</div>
                            <div class="l2p-wk-card-count">
                                <strong>@ev.Attendees.Count</strong>
                                <span class="l2p-wk-muted">z @PartySize</span>
                                <span class="l2p-wk-meter"><span style="@MeterStyle(ev.Attendees.Count)"></span></span>
                            </div>
                            <div class="l2p-wk-attendees">
                                @foreach (var attendee in ev.Attendees)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@(attendee.UserId == _userId ? Color.Primary : Color.Default)"
                                             Href="@DisplayFormat.PlayerUrl(attendee.UserId, _week)">@attendee.Nick</MudChip>
                                }
                            </div>
                        </MudPaper>
                    }
                </div>
            }
            else
            {
                <div class="l2p-wk-grid-scroll">
                    <table class="l2p-wk-grid">
                        <thead>
                            <tr>
                                <th class="l2p-wk-grid-nick" scope="col">Hráč</th>
                                @foreach (var ev in events)
                                {
                                    <th scope="col">
                                        @KindBadge(ev)
                                        <span class="l2p-wk-grid-boss">@ev.Activity.Name</span>
                                        <span class="l2p-wk-muted">@DisplayFormat.EventTime(ev.Date, ev.TimeUtc)</span>
                                    </th>
                                }
                                <th scope="col">Den</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _overview.Players)
                            {
                                var player = row.Player;
                                var attended = events.Count(e => e.Attendees.Any(a => a.UserId == player.UserId));
                                <tr class="@(player.UserId == _userId ? "l2p-wk-grid-me" : null)">
                                    <th class="l2p-wk-grid-nick" scope="row">
                                        <MudLink Href="@DisplayFormat.PlayerUrl(player.UserId, _week)" Underline="Underline.Hover"
                                                 Color="@(player.IsActive ? Color.Primary : Color.Inherit)">@player.Nick</MudLink>
                                    </th>
                                    @foreach (var ev in events)
                                    {
                                        <td>
                                            @if (ev.Attendees.Any(a => a.UserId == player.UserId))
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="l2p-wk-yes" title="Byl(a) tam" />
                                            }
                                            else
                                            {
                                                <span class="l2p-wk-no" aria-label="Nebyl(a)">·</span>
                                            }
                                        </td>
                                    }
                                    <td class="l2p-wk-grid-sum">@attended/@events.Count</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th class="l2p-wk-grid-nick" scope="row">Počet</th>
                                @foreach (var ev in events)
                                {
                                    <td class="l2p-wk-grid-sum">@ev.Attendees.Count</td>
                                }
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </MudPaper>
    </section>
}

@code {
    private enum EventView { Cards, Grid }

    private string ViewLabelClass(EventView view) => _view == view ? "l2p-view-label l2p-view-label-on" : "l2p-view-label";

    private readonly CancellationTokenSource _disposed = new();

    private WeekOverviewData? _overview;
    private LeaderboardSummary? _summary;
    private IReadOnlyDictionary<string, int> _weekRanks = new Dictionary<string, int>();
    private ILookup<DateOnly, WeekEvent> _eventsByDay = Enumerable.Empty<WeekEvent>().ToLookup(e => e.Date);
    private DateOnly _today;
    private Week _week;
    private DateOnly _day;
    private EventView _view = EventView.Cards;
    private string? _userId;
    private bool _loadedOnce;
    private bool _loading;
    private bool _error;
    // Only the result of the latest request is applied.
    private int _version;

    [SupplyParameterFromQuery(Name = "week")]
    public string? WeekParameter { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _today = AppTime.TodayInPrague(Time);
        var week = Week.ParseOrCurrent(WeekParameter, _today);
        var changed = !_loadedOnce || week != _week;
        _week = week;

        if (_userId is null)
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _userId = UserManager.GetUserId(state.User);
        }

        if (!changed)
        {
            return;
        }

        _loadedOnce = true;
        await LoadAsync();
    }

    private int PartySize => _overview?.Players.Count ?? 0;

    private string PreviousWeekNote => _overview?.PreviousWeekPoints is { } previous
        ? $"předchozí týden {DisplayFormat.Points(previous)}"
        : "za týden";

    private string AverageNote => _overview is { Events.Count: > 0 } overview
        ? $"průměrně {overview.Events.Average(e => e.Attendees.Count).ToString("0.#", CultureInfo.GetCultureInfo("cs-CZ"))} lidí na epic"
        : "zatím nic";

    private IReadOnlyList<WeekEvent> EventsOn(DateOnly day) => _eventsByDay[day].ToList();

    private string DayClass(DateOnly day, int count)
    {
        var css = "l2p-wk-day";
        if (day == _day)
        {
            css += " l2p-wk-day-selected";
        }

        if (count == 0)
        {
            css += " l2p-wk-day-empty";
        }

        return day == _today ? css + " l2p-wk-day-today" : css;
    }

    private string MeterStyle(int count) =>
        PartySize == 0 ? "width: 0%" : $"width: {Math.Min(100.0, count * 100.0 / PartySize).ToString("0.#", CultureInfo.InvariantCulture)}%";

    private static RenderFragment KindBadge(WeekEvent ev) =>
        @<span class="@($"l2p-wk-kind l2p-wk-kind-{DisplayFormat.EventKindKey(ev.Activity.Category, ev.Slot)}")">@DisplayFormat.EventKindLabel(ev.Activity.Category, ev.Slot)</span>;

    private void OnWeekChanged(Week week)
    {
        Navigation.NavigateTo(week == Week.Containing(_today) ? "/week" : $"/week?week={week.Monday:yyyy-MM-dd}");
    }

    private async Task LoadAsync()
    {
        var version = ++_version;
        var week = _week;
        _error = false;
        _loading = true;
        try
        {
            var overview = await Overview.GetWeekOverviewAsync(week, _disposed.Token);
            if (version == _version)
            {
                _overview = overview;
                _summary = LeaderboardSummaryCalculator.Calculate(overview.Players, _userId);
                _weekRanks = LeaderboardSummaryCalculator.Ranks(overview.Players, r => r.Week.Points);
                _eventsByDay = overview.Events.ToLookup(e => e.Date);
                _day = WeekEventsCalculator.DefaultDay(week, _today, overview.Events);
                _loading = false;
            }
        }
        catch (OperationCanceledException)
        {
            // The component was disposed while loading.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the overview of week {Week} failed", week.Monday);
            if (version == _version)
            {
                _overview = null;
                _error = true;
                _loading = false;
            }
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
