@page "/points"
@using L2Points.Domain.Activities
@using L2Points.Domain.Time
@using L2Points.Infrastructure.Services
@using L2Points.Web.Formatting
@inject CatalogAdminService Catalog
@inject TimeProvider Time
@inject ILogger<Points> Logger
@implements IDisposable

<PageTitle>Body – L2Points</PageTitle>

<PageHeader Title="Body" />
<MudText Typo="Typo.body2" Class="mb-3">Kolik bodů dostaneš za účast na jednotlivých událostech. Body nastavuje admin a změna platí zpětně i pro už zapsané účasti.</MudText>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">Body se nepodařilo načíst. Zkus to prosím znovu.</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">Zkusit znovu</MudButton>
}
else if (_activities is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else
{
    @foreach (var (category, title, icon) in Groups)
    {
        var items = _activities.Where(a => a.Category == category && a.IsActive).ToList();
        if (items.Count == 0)
        {
            continue;
        }

        <section class="l2p-section">
            <SectionTitle Text="@title" Icon="@icon" />
            <div class="l2p-points l2p-catalog-table">
                <MudTable T="Activity" Items="items" Dense="true" Elevation="0" Outlined="true" Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        <MudTh Class="l2p-nick-cell">Název</MudTh>
                        @if (category == ActivityCategory.ChaoticEpic)
                        {
                            <MudTh Class="l2p-points-value l2p-col-points">Večerní</MudTh>
                            <MudTh Class="l2p-points-value l2p-col-points">Ranní</MudTh>
                        }
                        else
                        {
                            <MudTh Class="l2p-points-value l2p-col-points">Body</MudTh>
                        }
                        <MudTh>Rozpis</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="l2p-nick-cell">@context.Name</MudTd>
                        @if (category == ActivityCategory.ChaoticEpic)
                        {
                            <MudTd Class="l2p-points-value l2p-col-points">@SlotPoints(context, EventSlot.Evening)</MudTd>
                            <MudTd Class="l2p-points-value l2p-col-points">@SlotPoints(context, EventSlot.Morning)</MudTd>
                        }
                        else
                        {
                            <MudTd Class="l2p-points-value l2p-col-points">@context.Points</MudTd>
                        }
                        <MudTd>@DisplayFormat.ScheduleLabel(context, _week)</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </section>
    }
}

@code {
    /// <summary>The current week in Prague; weekly times are converted for its dates (daylight saving).</summary>
    private Week _week => Week.Containing(AppTime.TodayInPrague(Time));

    private static readonly (ActivityCategory Category, string Title, string Icon)[] Groups =
    [
        (ActivityCategory.NormalEpic, "Normal epicy", Icons.Material.Outlined.LocalFireDepartment),
        (ActivityCategory.ChaoticEpic, "Chaotic epicy", Icons.Material.Outlined.Bolt),
        (ActivityCategory.CastleSiege, "Castle Siege", Icons.Material.Outlined.Castle),
    ];

    private readonly CancellationTokenSource _disposed = new();

    private IReadOnlyList<Activity>? _activities;
    private bool _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // A slot override wins over the base points of the activity, same as in PointsCalculator.
    private static int SlotPoints(Activity activity, EventSlot slot) =>
        activity.SlotPoints.FirstOrDefault(s => s.Slot == slot)?.Points ?? activity.Points;

    private async Task LoadAsync()
    {
        _error = false;
        try
        {
            _activities = await Catalog.GetActivitiesAsync(_disposed.Token);
        }
        catch (OperationCanceledException)
        {
            // The component was disposed while loading.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading activities failed");
            _activities = null;
            _error = true;
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
