@page "/admin/players"
@attribute [Authorize(Roles = Roles.Admin)]
@using System.Globalization
@using L2Points.Domain.Time
@using L2Points.Infrastructure.Services
@using L2Points.Web.Components.Admin
@using L2Points.Web.Formatting
@inject PlayerAdminService PlayerAdmin
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TimeProvider Time
@inject ILogger<AdminPlayers> Logger
@implements IDisposable

<PageTitle>Hráči – Admin – L2Points</PageTitle>

<PageHeader Title="Hráči" />

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">Hráče se nepodařilo načíst. Zkus to prosím znovu.</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">Zkusit znovu</MudButton>
}
else if (_players is null)
{
    <LoadingSkeleton />
}
else
{
    <div class="mb-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   Disabled="_saving" OnClick="CreateAsync">Nový účet</MudButton>
    </div>

    <div class="l2p-ap">
        <MudTable T="AdminPlayer" Items="_players" Dense="true" Elevation="0" Outlined="true" Breakpoint="Breakpoint.None"
                  Class="d-none d-sm-block">
            <HeaderContent>
                <MudTh Class="l2p-nick-cell">Nick</MudTh>
                <MudTh>Login</MudTh>
                <MudTh>Aktivní od</MudTh>
                <MudTh>Stav</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Akce</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    var player = context;
                    var state = PlayerActionState.For(player, _actorId, ActorIsSuperAdmin);
                }
                <MudTd Class="l2p-nick-cell">
                    @* A hidden reader has no detail page (it is "not found" for everybody), so no link. *@
                    @if (IsHidden(player))
                    {
                        <span>@player.Nick</span>
                    }
                    else
                    {
                        <MudLink Href="@DisplayFormat.PlayerUrl(player.UserId)" Underline="Underline.Hover">@player.Nick</MudLink>
                    }
                </MudTd>
                <MudTd>@player.Login</MudTd>
                <MudTd>@FormatDate(player.ActiveFrom)</MudTd>
                <MudTd>
                    @if (player.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">aktivní</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@InactiveText(player)</MudChip>
                    }
                </MudTd>
                <MudTd>
                    @if (player.IsSuperAdmin)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">Super admin</MudChip>
                    }
                    else if (player.IsAdmin)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">admin</MudChip>
                    }
                    @if (player.IsReader)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">čtenář</MudChip>
                    }
                    @if (IsHidden(player))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">skrytý</MudChip>
                    }
                </MudTd>
                <MudTd>
                    <PlayerActions Player="player" State="state" Busy="_saving" OnEdit="@(() => EditAsync(player))"
                                   OnResetPassword="@(() => ResetPasswordAsync(player))"
                                   OnDelete="@(() => DeleteAsync(player))"
                                   OnSetActive="@(active => SetActiveAsync(player, active))"
                                   OnSetAdmin="@(isAdmin => SetAdminAsync(player, isAdmin))"
                                   OnSetReader="@(isReader => SetReaderAsync(player, isReader))"
                                   OnSetShowInStats="@(show => SetShowInStatsAsync(player, show))" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <div class="d-sm-none l2p-ap-cards">
            @foreach (var player in _players)
            {
                var state = PlayerActionState.For(player, _actorId, ActorIsSuperAdmin);
                <MudPaper Outlined="true" Class="l2p-tile l2p-ap-card" @key="player.UserId">
                    <div class="l2p-ap-card-head">
                        @if (IsHidden(player))
                        {
                            <span class="l2p-ap-card-nick">@player.Nick</span>
                        }
                        else
                        {
                            <MudLink Href="@DisplayFormat.PlayerUrl(player.UserId)" Underline="Underline.Hover"
                                     Class="l2p-ap-card-nick">@player.Nick</MudLink>
                        }
                        <div class="l2p-ap-card-chips">
                            @if (player.IsActive)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">aktivní</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@InactiveText(player)</MudChip>
                            }
                            @if (player.IsSuperAdmin)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">Super admin</MudChip>
                            }
                            else if (player.IsAdmin)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">admin</MudChip>
                            }
                            @if (player.IsReader)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">čtenář</MudChip>
                            }
                            @if (IsHidden(player))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">skrytý</MudChip>
                            }
                        </div>
                    </div>
                    <div class="l2p-ap-card-meta">@player.Login · aktivní od @FormatDate(player.ActiveFrom)</div>
                    <PlayerActions Player="player" State="state" Busy="_saving" OnEdit="@(() => EditAsync(player))"
                                   OnResetPassword="@(() => ResetPasswordAsync(player))"
                                   OnDelete="@(() => DeleteAsync(player))"
                                   OnSetActive="@(active => SetActiveAsync(player, active))"
                                   OnSetAdmin="@(isAdmin => SetAdminAsync(player, isAdmin))"
                                   OnSetReader="@(isReader => SetReaderAsync(player, isReader))"
                                   OnSetShowInStats="@(show => SetShowInStatsAsync(player, show))" />
                </MudPaper>
            }
        </div>
    </div>
}

@code {
    private static readonly DialogOptions EditOptions = new()
    {
        MaxWidth = MaxWidth.ExtraSmall,
        FullWidth = true,
        BackdropClick = false,
        CloseOnEscapeKey = true,
    };

    // The password is shown only once, so the dialog must not close by an accidental click outside.
    private static readonly DialogOptions PasswordOptions = new()
    {
        MaxWidth = MaxWidth.ExtraSmall,
        FullWidth = true,
        BackdropClick = false,
        CloseOnEscapeKey = false,
    };

    private readonly CancellationTokenSource _disposed = new();

    private IReadOnlyList<AdminPlayer>? _players;
    private string? _actorId;
    private bool _error;
    private bool _saving;

    // Taken from the loaded rows (database), not from the claims, which may be stale until the next sign-in.
    private bool ActorIsSuperAdmin => _players?.Any(p => p.UserId == _actorId && p.IsSuperAdmin) == true;

    protected override async Task OnInitializedAsync()
    {
        // Identity comes only from the authenticated principal.
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _actorId = UserManager.GetUserId(state.User);
        await LoadAsync();
    }

    private static string FormatDate(DateOnly date) => date.ToString("d. M. yyyy", CultureInfo.InvariantCulture);

    private static bool IsHidden(AdminPlayer player) => player.IsReader && !player.ShowInStats;

    private static string InactiveText(AdminPlayer player) =>
        player.DeactivatedAt is { } date ? $"neaktivní od {FormatDate(date)}" : "neaktivní";

    private async Task CreateAsync()
    {
        var monday = Week.Containing(AppTime.TodayInPrague(Time)).Monday;
        var values = await ShowEditDialogAsync(string.Empty, string.Empty, monday);
        if (values is null)
        {
            return;
        }

        await ChangeAsync(ct => PlayerAdmin.CreateAsync(values.Login, values.Nick, values.ActiveFrom, values.IsReader, values.ShowInStats, ct), values.Nick);
    }

    private async Task EditAsync(AdminPlayer player)
    {
        var values = await ShowEditDialogAsync(null, player.Nick, player.ActiveFrom);
        if (values is null)
        {
            return;
        }

        await ChangeAsync(ct => PlayerAdmin.UpdateAsync(player.UserId, values.Nick, values.ActiveFrom, ct));
    }

    private async Task ResetPasswordAsync(AdminPlayer player)
    {
        if (!await ConfirmAsync("Reset hesla",
                $"Vygenerovat účtu {player.Nick} nové heslo? Staré heslo přestane platit.", "Resetovat"))
        {
            return;
        }

        await ChangeAsync(ct => PlayerAdmin.ResetPasswordAsync(_actorId!, player.UserId, ct), player.Nick);
    }

    private async Task SetActiveAsync(AdminPlayer player, bool active)
    {
        if (!active && !await ConfirmAsync("Deaktivace účtu",
                $"Deaktivovat účet {player.Nick}? Nebude se moct přihlásit, jeho historie zůstane.", "Deaktivovat"))
        {
            return;
        }

        var reactivated = await ChangeAsync(ct => PlayerAdmin.SetActiveAsync(_actorId!, player.UserId, active, ct));
        if (active && reactivated)
        {
            Snackbar.Add("Hráč je znovu aktivní. Pokud se vrací po delší době, posuň mu „aktivní od“.", Severity.Info);
        }
    }

    private async Task SetAdminAsync(AdminPlayer player, bool isAdmin)
    {
        if (!isAdmin && !await ConfirmAsync("Odebrání admina",
                $"Odebrat hráči {player.Nick} roli Admin?", "Odebrat"))
        {
            return;
        }

        await ChangeAsync(ct => PlayerAdmin.SetAdminAsync(_actorId!, player.UserId, isAdmin, ct));
    }

    private Task SetReaderAsync(AdminPlayer player, bool isReader) =>
        ChangeAsync(ct => PlayerAdmin.SetReaderAsync(_actorId!, player.UserId, isReader, ct));

    private Task SetShowInStatsAsync(AdminPlayer player, bool show) =>
        ChangeAsync(ct => PlayerAdmin.SetShowInStatsAsync(_actorId!, player.UserId, show, ct));

    private async Task DeleteAsync(AdminPlayer player)
    {
        if (!await ConfirmAsync("Smazání účtu",
                $"Smazat účet {player.Nick}? Smaže se i jeho účast a šperky. Akci nelze vrátit.", "Smazat"))
        {
            return;
        }

        await ChangeAsync(ct => PlayerAdmin.DeleteAsync(_actorId!, player.UserId, ct));
    }

    private async Task<PlayerEditDialog.Values?> ShowEditDialogAsync(string? login, string nick, DateOnly activeFrom)
    {
        var parameters = new DialogParameters<PlayerEditDialog>
        {
            { d => d.Login, login },
            { d => d.Nick, nick },
            { d => d.ActiveFrom, activeFrom },
        };
        var dialog = await DialogService.ShowAsync<PlayerEditDialog>(parameters, EditOptions);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: PlayerEditDialog.Values values } ? values : null;
    }

    private async Task<bool> ConfirmAsync(string title, string message, string yesText) =>
        await DialogService.ShowMessageBoxAsync(title, message, yesText: yesText, cancelText: "Zrušit") == true;

    /// <summary>
    /// Runs one change; a returned password is shown to the admin (to <paramref name="passwordNick"/>) and not kept.
    /// Returns true when the change succeeded.
    /// </summary>
    private async Task<bool> ChangeAsync(Func<CancellationToken, Task<PlayerAdminResult>> change, string? passwordNick = null)
    {
        if (_saving || _actorId is null)
        {
            return false;
        }

        // Captured up front: reading Token from a disposed source throws.
        var ct = _disposed.Token;
        _saving = true;
        var succeeded = false;
        try
        {
            var result = await change(ct);
            if (result.Status == PlayerAdminStatus.Ok)
            {
                succeeded = true;
                if (result.Password is { } password)
                {
                    var parameters = new DialogParameters<PasswordDialog>
                    {
                        { d => d.Nick, passwordNick ?? string.Empty },
                        { d => d.Password, password },
                    };
                    await DialogService.ShowAsync<PasswordDialog>(parameters, PasswordOptions);
                }
            }
            else
            {
                Snackbar.Add(ErrorText(result), Severity.Warning);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // The component was disposed while saving.
            _saving = false;
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Changing a player failed");
            Snackbar.Add("Uložení se nepovedlo, zkus to znovu.", Severity.Error);
        }

        // The server is the source of truth; reload after every change, successful or not.
        try
        {
            _players = await PlayerAdmin.GetPlayersAsync(ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reloading players failed");
            _players = null;
            _error = true;
        }
        finally
        {
            _saving = false;
        }

        return succeeded;
    }

    private static string ErrorText(PlayerAdminResult result) => result.Status switch
    {
        PlayerAdminStatus.NickTaken => "Nick už používá jiný hráč.",
        PlayerAdminStatus.LoginTaken => "Login už existuje.",
        PlayerAdminStatus.CannotChangeSelf => "Sám sobě to udělat nemůžeš.",
        PlayerAdminStatus.UnknownPlayer => "Hráč už neexistuje.",
        PlayerAdminStatus.ActorNotAllowed => "Tuto akci už nemůžeš provést.",
        PlayerAdminStatus.RequiresSuperAdmin => "Admin práva může měnit jen super admin.",
        PlayerAdminStatus.SuperAdminProtected => PlayerActionState.SuperAdminProtectedText,
        PlayerAdminStatus.AdminProtected => PlayerActionState.AdminProtectedText,
        PlayerAdminStatus.AdminCannotBeReader => PlayerActionState.AdminReaderText,
        PlayerAdminStatus.ReaderCannotBeAdmin => "Čtenáři nejde dát admina, nejdřív ho přepni na hráče.",
        PlayerAdminStatus.NotReader => "Ze statistik jde skrýt jen čtenář.",
        _ => result.Message ?? "Uložení se nepovedlo, zkus to znovu.",
    };

    private async Task LoadAsync()
    {
        _error = false;
        try
        {
            _players = await PlayerAdmin.GetPlayersAsync(_disposed.Token);
        }
        catch (OperationCanceledException)
        {
            // The component was disposed while loading.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading players failed");
            _players = null;
            _error = true;
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
