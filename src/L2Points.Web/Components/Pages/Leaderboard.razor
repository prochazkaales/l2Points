@page "/leaderboard"
@using System.Globalization
@using L2Points.Domain.Jewels
@using L2Points.Domain.Stats
@using L2Points.Domain.Time
@using L2Points.Infrastructure.Services
@using L2Points.Web.Components.Attendance
@using L2Points.Web.Components.Jewels
@using L2Points.Web.Components.Stats
@using L2Points.Web.Formatting
@inject OverviewService Overview
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject ILogger<Leaderboard> Logger
@implements IDisposable

<PageTitle>Přehled – L2Points</PageTitle>

<div class="l2p-lb-head mb-3">
    <MudText Typo="Typo.h4">Přehled</MudText>
    <MudSwitch T="bool" Value="_includeInactive" ValueChanged="OnInactiveChanged" Color="Color.Primary"
               Label="Zobrazit neaktivní" />
</div>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">Přehled se nepodařilo načíst. Zkus to prosím znovu.</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">Zkusit znovu</MudButton>
}
else if (_rows is null || _summary is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_rows.Count == 0)
{
    <MudAlert Severity="Severity.Normal">Zatím tu nikdo není.</MudAlert>
}
else
{
    <div class="l2p-kpis mb-4">
        <MudPaper Outlined="true" Class="l2p-kpi">
            <MudText Typo="Typo.caption" Class="l2p-kpi-label">Účast party</MudText>
            <div class="l2p-kpi-value">@DisplayFormat.Percent(_summary.PartyAttendance.Percent)</div>
            <MudText Typo="Typo.caption" Class="l2p-kpi-note">celkově</MudText>
        </MudPaper>
        <MudPaper Outlined="true" Class="l2p-kpi">
            <MudText Typo="Typo.caption" Class="l2p-kpi-label">Body party</MudText>
            <div class="l2p-kpi-value">@DisplayFormat.Points(_summary.WeekPoints)</div>
            <MudText Typo="Typo.caption" Class="l2p-kpi-note">@PartyPointsNote</MudText>
        </MudPaper>
        <MudPaper Outlined="true" Class="l2p-kpi">
            <MudText Typo="Typo.caption" Class="l2p-kpi-label">Hráč týdne</MudText>
            @if (_summary.PlayersOfWeek.Count > 0)
            {
                var best = _summary.PlayersOfWeek[0];
                <div class="l2p-kpi-value l2p-kpi-player" title="@string.Join(", ", _summary.PlayersOfWeek.Select(p => p.Nick))">
                    <MudLink Href="@DisplayFormat.PlayerUrl(best.UserId, _week)" Underline="Underline.Hover" Color="Color.Primary">@best.Nick</MudLink>
                    @if (_summary.PlayersOfWeek.Count > 1)
                    {
                        <span class="l2p-kpi-more">+@(_summary.PlayersOfWeek.Count - 1)</span>
                    }
                </div>
                <MudText Typo="Typo.caption" Class="l2p-kpi-note">@DisplayFormat.PointsCount(_summary.PlayersOfWeekPoints) · @WeekCaption</MudText>
            }
            else
            {
                <div class="l2p-kpi-value">–</div>
                <MudText Typo="Typo.caption" Class="l2p-kpi-note">zatím nikdo · @WeekCaption</MudText>
            }
        </MudPaper>
        <MudPaper Outlined="true" Class="l2p-kpi">
            <MudText Typo="Typo.caption" Class="l2p-kpi-label">Tvoje pořadí</MudText>
            <div class="l2p-kpi-value">@(_summary.Me is { } me ? $"{me.Rank}." : "–")</div>
            <MudText Typo="Typo.caption" Class="l2p-kpi-note">@StandingNote</MudText>
        </MudPaper>
    </div>

    @if (_summary.Podium.Count > 0)
    {
        <div class="l2p-podium mb-4">
            @for (var i = 0; i < _summary.Podium.Count; i++)
            {
                var row = _summary.Podium[i];
                var rank = _summary.Ranks[row.Player.UserId];
                <MudPaper Outlined="true" Class="@($"l2p-podium-card l2p-podium-{i + 1} l2p-place-{rank}" + (row.Player.UserId == _userId ? " l2p-podium-me" : ""))">
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="l2p-podium-trophy" />
                    <div class="l2p-podium-nick">
                        <MudLink Href="@DisplayFormat.PlayerUrl(row.Player.UserId)" Underline="Underline.Hover" Color="Color.Primary">@row.Player.Nick</MudLink>
                        <JewelIcons Jewels="_jewels.Of(row.Player.UserId)" />
                    </div>
                    <div class="l2p-podium-points">@DisplayFormat.Points(row.Overall.Points)</div>
                    <MudText Typo="Typo.caption" Class="l2p-podium-caption">bodů celkem</MudText>
                    <span class="@ToneClass(row.Overall.Stats.Total.Percent)" title="Účast celkem">@DisplayFormat.Percent(row.Overall.Stats.Total.Percent)</span>
                </MudPaper>
            }
        </div>
    }

    <MudPaper Outlined="true" Class="l2p-lb-section mb-4">
        <div class="l2p-lb-section-head">
            <MudText Typo="Typo.subtitle2" Class="l2p-lb-section-title">Celkově</MudText>
        </div>
        <div class="l2p-lb">
            <MudTable T="LeaderboardRow" Items="_rows" Dense="true" Elevation="0" Breakpoint="Breakpoint.None" RowClassFunc="RowClass">
                <HeaderContent>
                    <MudTh Class="l2p-lb-rank"></MudTh>
                    <MudTh Class="l2p-nick-cell">Hráč</MudTh>
                    @SortHeader(Columns[0], s => s.Overall, SortDirection.Descending)
                    <MudTh Class="l2p-lb-bar-cell"></MudTh>
                    @foreach (var column in Columns.Skip(1))
                    {
                        @SortHeader(column, s => s.Overall, SortDirection.None)
                    }
                </HeaderContent>
                <RowTemplate>
                    @RankCell(_summary.Ranks[context.Player.UserId])
                    <PlayerNickCell Player="context.Player" Jewels="_jewels.Of(context.Player.UserId)" />
                    <MudTd Class="l2p-stat-points">@DisplayFormat.Points(context.Overall.Points)</MudTd>
                    <MudTd Class="l2p-lb-bar-cell">
                        <div class="l2p-lb-bar"><span style="@BarStyle(context.Overall.Points)"></span></div>
                    </MudTd>
                    <StatCells Stats="context.Overall.Stats" ShowPoints="false" Toned="true" />
                </RowTemplate>
            </MudTable>
        </div>
    </MudPaper>

    <MudPaper Outlined="true" Class="l2p-lb-section">
        <div class="l2p-lb-section-head">
            <MudText Typo="Typo.subtitle2" Class="l2p-lb-section-title">Týden</MudText>
            <WeekNavigator Week="_week" Today="_today" WeekChanged="OnWeekChanged" />
        </div>
        <div class="l2p-lb">
            <MudTable T="LeaderboardRow" Items="_weekRows" Dense="true" Elevation="0" Breakpoint="Breakpoint.None" RowClassFunc="RowClass">
                <HeaderContent>
                    <MudTh Class="l2p-lb-rank"></MudTh>
                    <MudTh Class="l2p-nick-cell">Hráč</MudTh>
                    @foreach (var column in Columns)
                    {
                        @SortHeader(column, s => s.Week, column.IsFirst ? SortDirection.Descending : SortDirection.None)
                    }
                </HeaderContent>
                <RowTemplate>
                    @RankCell(_weekRanks[context.Player.UserId])
                    <PlayerNickCell Player="context.Player" Jewels="_jewels.Of(context.Player.UserId)" Week="_week" />
                    <StatCells Stats="context.Week.Stats" Points="context.Week.Points" Toned="true" />
                </RowTemplate>
            </MudTable>
        </div>
    </MudPaper>
}

@code {
    private sealed record Column(string Label, Func<PlayerSummary, object> Key, bool IsFirst = false);

    // Missing percentages sort below 0 %.
    private static object PercentKey(CategoryStat stat) => stat.Percent ?? -1.0;

    private static readonly Column[] Columns =
    [
        new("Body", s => s.Points, IsFirst: true),
        new("Celkem", s => PercentKey(s.Stats.Total)),
        new(DisplayFormat.CategoryLabel(StatCategory.Normal), s => PercentKey(s.Stats[StatCategory.Normal])),
        new(DisplayFormat.CategoryLabel(StatCategory.Evening), s => PercentKey(s.Stats[StatCategory.Evening])),
        new(DisplayFormat.CategoryLabel(StatCategory.Morning), s => PercentKey(s.Stats[StatCategory.Morning])),
        new(DisplayFormat.CategoryLabel(StatCategory.CastleSiege), s => PercentKey(s.Stats[StatCategory.CastleSiege])),
    ];

    private readonly CancellationTokenSource _disposed = new();

    private IReadOnlyList<LeaderboardRow>? _rows;
    // The week table starts ordered by the week's points (ties by nick, as the overall order breaks them).
    private IReadOnlyList<LeaderboardRow> _weekRows = [];
    private LeaderboardSummary? _summary;
    private IReadOnlyDictionary<string, int> _weekRanks = new Dictionary<string, int>();
    private int? _previousWeekPoints;
    private JewelsByPlayer _jewels = JewelsByPlayer.Empty;
    private DateOnly _today;
    private Week _week;
    private bool _includeInactive;
    private bool _loadedOnce;
    private string? _userId;
    private bool _error;
    // Only the result of the latest request is applied.
    private int _version;

    [SupplyParameterFromQuery(Name = "week")]
    public string? WeekParameter { get; set; }

    [SupplyParameterFromQuery(Name = "inactive")]
    public string? InactiveParameter { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _today = AppTime.TodayInPrague(Time);
        var week = Week.ParseOrCurrent(WeekParameter, _today);
        var includeInactive = InactiveParameter == "1";
        var changed = !_loadedOnce || week != _week || includeInactive != _includeInactive;
        _week = week;
        _includeInactive = includeInactive;

        if (_userId is null)
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _userId = UserManager.GetUserId(state.User);
        }

        if (!changed)
        {
            return;
        }

        _loadedOnce = true;
        _rows = null;
        await LoadAsync();
    }

    private string WeekCaption => _week == Week.Containing(_today) ? "tento týden" : DisplayFormat.WeekLabel(_week);

    private string PartyPointsNote => _previousWeekPoints is { } previous
        ? $"{WeekCaption} · předchozí týden {DisplayFormat.Points(previous)}"
        : WeekCaption;

    private string StandingNote
    {
        get
        {
            if (_summary?.Me is not { } me)
            {
                return "nejsi v přehledu";
            }

            var parts = new List<string>(2);
            if (me.Behind is { } behind)
            {
                parts.Add($"{DisplayFormat.PointsCount(behind)} za hráčem před tebou");
            }
            else if (!me.Shared && me.Ahead is { } ahead)
            {
                parts.Add($"vedeš o {DisplayFormat.PointsCount(ahead)}");
            }

            if (me.Shared)
            {
                parts.Add("dělené místo");
            }

            return string.Join(" · ", parts);
        }
    }

    private int LeaderPoints => _rows is { Count: > 0 } rows ? rows[0].Overall.Points : 0;

    private string BarStyle(int points) =>
        LeaderPoints == 0 ? "width: 0%" : $"width: {(points * 100.0 / LeaderPoints).ToString("0.#", CultureInfo.InvariantCulture)}%";

    private static string ToneClass(double? percent) =>
        DisplayFormat.PercentTone(percent) is { } tone ? $"l2p-tone l2p-tone-{tone}" : "l2p-stat-empty";

    private static RenderFragment SortHeader(Column column, Func<LeaderboardRow, PlayerSummary> period, SortDirection initial) => @<MudTh Class="@(column.IsFirst ? "l2p-lb-col l2p-lb-points-col" : "l2p-lb-col")">
        <MudTableSortLabel T="LeaderboardRow" SortBy="@(new Func<LeaderboardRow, object>(r => column.Key(period(r))))" InitialDirection="@initial">
            @column.Label
        </MudTableSortLabel>
    </MudTh>;

    private static RenderFragment RankCell(int rank) => @<MudTd Class="l2p-lb-rank"><span class="@($"l2p-place-{rank}")">@(rank).</span></MudTd>;

    private string RowClass(LeaderboardRow row, int index)
    {
        var classes = new List<string>(2);
        if (row.Player.UserId == _userId)
        {
            classes.Add("l2p-lb-me");
        }

        if (!row.Player.IsActive)
        {
            classes.Add("l2p-lb-inactive");
        }

        return string.Join(' ', classes);
    }

    private void OnWeekChanged(Week week) => NavigateTo(week, _includeInactive);

    private void OnInactiveChanged(bool value) => NavigateTo(_week, value);

    private void NavigateTo(Week week, bool includeInactive)
    {
        var query = new List<string>(2);
        if (week != Week.Containing(_today))
        {
            query.Add($"week={week.Monday:yyyy-MM-dd}");
        }

        if (includeInactive)
        {
            query.Add("inactive=1");
        }

        Navigation.NavigateTo(query.Count == 0 ? "/leaderboard" : $"/leaderboard?{string.Join('&', query)}");
    }

    private async Task LoadAsync()
    {
        var version = ++_version;
        var week = _week;
        _error = false;
        try
        {
            var result = await Overview.GetLeaderboardAsync(week, _includeInactive, _disposed.Token);
            if (version == _version)
            {
                _rows = result.Rows;
                _jewels = result.Jewels;
                _previousWeekPoints = result.PreviousWeekPoints;
                _summary = LeaderboardSummaryCalculator.Calculate(result.Rows, _userId);
                _weekRanks = LeaderboardSummaryCalculator.Ranks(result.Rows, r => r.Week.Points);
                _weekRows = result.Rows.OrderByDescending(r => r.Week.Points).ToList();
            }
        }
        catch (OperationCanceledException)
        {
            // The component was disposed while loading.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the leaderboard of week {Week} failed", week.Monday);
            if (version == _version)
            {
                _rows = null;
                _error = true;
            }
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
