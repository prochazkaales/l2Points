@page "/leaderboard"
@using L2Points.Domain.Jewels
@using L2Points.Domain.Stats
@using L2Points.Domain.Time
@using L2Points.Infrastructure.Services
@using L2Points.Web.Components.Attendance
@using L2Points.Web.Components.Jewels
@using L2Points.Web.Components.Stats
@using L2Points.Web.Formatting
@inject OverviewService Overview
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject ILogger<Leaderboard> Logger
@implements IDisposable

<PageTitle>Přehled – L2Points</PageTitle>

<PageHeader Title="Přehled">
    <MudSwitch T="bool" Value="_includeInactive" ValueChanged="OnInactiveChanged" Color="Color.Primary"
               Label="Zobrazit neaktivní" />
</PageHeader>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">Přehled se nepodařilo načíst. Zkus to prosím znovu.</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">Zkusit znovu</MudButton>
}
else if (_rows is null || _summary is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_rows.Count == 0)
{
    <MudAlert Severity="Severity.Normal">Zatím tu nikdo není.</MudAlert>
}
else
{
    @* While reloading, the current numbers stay on screen; only a thin progress line shows. *@
    <div class="l2p-lb-week-loading mb-1">
        @if (_loading == LoadScope.All)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
        }
    </div>

    <div class="l2p-kpis mb-4">
        <KpiCard Label="Účast party" Note="celkově">@DisplayFormat.Percent(_summary.PartyAttendance.Percent)</KpiCard>
        <KpiCard Label="Body party" Note="@PartyPointsNote">@DisplayFormat.Points(_summary.WeekPoints)</KpiCard>
        @if (_summary.PlayersOfWeek.Count > 0)
        {
            var best = _summary.PlayersOfWeek[0];
            <KpiCard Label="Hráč týdne" ValueTitle="@string.Join(", ", _summary.PlayersOfWeek.Select(p => p.Nick))"
                     Note="@($"{DisplayFormat.PointsCount(_summary.PlayersOfWeekPoints)} · {WeekCaption}")">
                <MudLink Href="@DisplayFormat.PlayerUrl(best.UserId, _week)" Underline="Underline.Hover" Color="Color.Primary">@best.Nick</MudLink>
                @if (_summary.PlayersOfWeek.Count > 1)
                {
                    <span class="l2p-kpi-more">+@(_summary.PlayersOfWeek.Count - 1)</span>
                }
            </KpiCard>
        }
        else
        {
            <KpiCard Label="Hráč týdne" Note="@($"zatím nikdo · {WeekCaption}")">–</KpiCard>
        }
        <KpiCard Label="Tvoje pořadí" Note="@StandingNote">@(_summary.Me is { } me ? $"{me.Rank}." : "–")</KpiCard>
    </div>

    @if (_summary.Podium.Count > 0)
    {
        <div class="l2p-podium mb-4">
            @for (var i = 0; i < _summary.Podium.Count; i++)
            {
                var row = _summary.Podium[i];
                var rank = _summary.Ranks[row.Player.UserId];
                <MudPaper Outlined="true" Class="@($"l2p-podium-card l2p-podium-{i + 1} l2p-place-{rank}" + (row.Player.UserId == _userId ? " l2p-podium-me" : ""))">
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="l2p-podium-trophy" />
                    <div class="l2p-podium-nick">
                        <MudLink Href="@DisplayFormat.PlayerUrl(row.Player.UserId)" Underline="Underline.Hover" Color="Color.Primary">@row.Player.Nick</MudLink>
                        <JewelIcons Jewels="_jewels.Of(row.Player.UserId)" />
                    </div>
                    <div class="l2p-podium-points">@DisplayFormat.Points(row.Overall.Points)</div>
                    <MudText Typo="Typo.caption" Class="l2p-podium-caption">bodů celkem</MudText>
                    <span class="@ToneClass(row.Overall.Stats.Total.Percent)" title="Účast celkem">@DisplayFormat.Percent(row.Overall.Stats.Total.Percent)</span>
                </MudPaper>
            }
        </div>
    }

    <section class="mb-4">
        <SectionTitle Text="Celkově" Icon="@Icons.Material.Outlined.EmojiEvents" />
        <MudPaper Outlined="true">
            <RankingTable Rows="_rows" Ranks="_summary.Ranks" Jewels="_jewels" UserId="@_userId" ShowBar="true" />
        </MudPaper>
    </section>

    <section>
        <SectionTitle Text="Týden" Icon="@Icons.Material.Outlined.DateRange">
            <WeekNavigator Week="_week" Today="_today" WeekChanged="OnWeekChanged" />
        </SectionTitle>
        <MudPaper Outlined="true" Style="position: relative">
            <div class="l2p-lb-week-loading">
                @if (_loading == LoadScope.Week)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                }
            </div>
            <RankingTable Rows="_weekRows" Ranks="_weekRanks" Jewels="_jewels" UserId="@_userId" Weekly="true" ShowBar="true" NickWeek="_week" />
        </MudPaper>
    </section>
}

@code {
    private enum LoadScope { None, Week, All }

    private readonly CancellationTokenSource _disposed = new();

    private IReadOnlyList<LeaderboardRow>? _rows;
    // The week table starts ordered by the week's points (ties by nick, as the overall order breaks them).
    private IReadOnlyList<LeaderboardRow> _weekRows = [];
    private LeaderboardSummary? _summary;
    private IReadOnlyDictionary<string, int> _weekRanks = new Dictionary<string, int>();
    private int? _previousWeekPoints;
    private JewelsByPlayer _jewels = JewelsByPlayer.Empty;
    private DateOnly _today;
    private Week _week;
    private bool _includeInactive;
    private bool _loadedOnce;
    private string? _userId;
    private bool _error;
    private LoadScope _loading;
    // Only the result of the latest request is applied.
    private int _version;

    [SupplyParameterFromQuery(Name = "week")]
    public string? WeekParameter { get; set; }

    [SupplyParameterFromQuery(Name = "inactive")]
    public string? InactiveParameter { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _today = AppTime.TodayInPrague(Time);
        var week = Week.ParseOrCurrent(WeekParameter, _today);
        var includeInactive = InactiveParameter == "1";
        var scope = !_loadedOnce || includeInactive != _includeInactive ? LoadScope.All
            : week != _week ? LoadScope.Week
            : LoadScope.None;
        _week = week;
        _includeInactive = includeInactive;

        if (_userId is null)
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _userId = UserManager.GetUserId(state.User);
        }

        if (scope == LoadScope.None)
        {
            return;
        }

        _loadedOnce = true;
        _loading = scope;
        await LoadAsync();
    }

    private string WeekCaption => _week == Week.Containing(_today) ? "tento týden" : DisplayFormat.WeekLabel(_week);

    private string PartyPointsNote => _previousWeekPoints is { } previous
        ? $"{WeekCaption} · předchozí týden {DisplayFormat.Points(previous)}"
        : WeekCaption;

    private string StandingNote
    {
        get
        {
            if (_summary?.Me is not { } me)
            {
                return "nejsi v přehledu";
            }

            var parts = new List<string>(2);
            if (me.Behind is { } behind)
            {
                parts.Add($"{DisplayFormat.PointsCount(behind)} za hráčem před tebou");
            }
            else if (!me.Shared && me.Ahead is { } ahead)
            {
                parts.Add($"vedeš o {DisplayFormat.PointsCount(ahead)}");
            }

            if (me.Shared)
            {
                parts.Add("dělené místo");
            }

            return string.Join(" · ", parts);
        }
    }

    private static string ToneClass(double? percent) =>
        DisplayFormat.PercentTone(percent) is { } tone ? $"l2p-tone l2p-tone-{tone}" : "l2p-stat-empty";

    private void OnWeekChanged(Week week) => NavigateTo(week, _includeInactive);

    private void OnInactiveChanged(bool value) => NavigateTo(_week, value);

    private void NavigateTo(Week week, bool includeInactive)
    {
        var query = new List<string>(2);
        if (week != Week.Containing(_today))
        {
            query.Add($"week={week.Monday:yyyy-MM-dd}");
        }

        if (includeInactive)
        {
            query.Add("inactive=1");
        }

        Navigation.NavigateTo(query.Count == 0 ? "/leaderboard" : $"/leaderboard?{string.Join('&', query)}");
    }

    private async Task LoadAsync()
    {
        var version = ++_version;
        var week = _week;
        _error = false;
        try
        {
            var result = await Overview.GetLeaderboardAsync(week, _includeInactive, _disposed.Token);
            if (version == _version)
            {
                _rows = result.Rows;
                _jewels = result.Jewels;
                _previousWeekPoints = result.PreviousWeekPoints;
                _summary = LeaderboardSummaryCalculator.Calculate(result.Rows, _userId);
                _weekRanks = LeaderboardSummaryCalculator.Ranks(result.Rows, r => r.Week.Points);
                _weekRows = result.Rows.OrderByDescending(r => r.Week.Points).ToList();
                _loading = LoadScope.None;
            }
        }
        catch (OperationCanceledException)
        {
            // The component was disposed while loading.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the leaderboard of week {Week} failed", week.Monday);
            if (version == _version)
            {
                _rows = null;
                _error = true;
                _loading = LoadScope.None;
            }
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
