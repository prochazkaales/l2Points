@page "/jewels"
@using L2Points.Domain.Jewels
@using L2Points.Infrastructure.Services
@using L2Points.Web.Components.Jewels
@using L2Points.Web.Formatting
@inject JewelService JewelData
@inject ILogger<Jewels> Logger
@implements IDisposable

<PageTitle>Šperky – L2Points</PageTitle>

<PageHeader Title="Šperky" />

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">Šperky se nepodařilo načíst. Zkus to prosím znovu.</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">Zkusit znovu</MudButton>
}
else if (_gallery is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else
{
    <div class="l2p-jewel-gallery">
        @foreach (var summary in _gallery)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <div class="l2p-jewel-head">
                    <div class="l2p-jewel-big">
                        <JewelIcon Type="summary.Type" Size="64" Decorative="true" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h6" HtmlTag="h2">@summary.Type.Name</MudText>
                        <MudText Typo="Typo.body2" Class="l2p-jewel-total">@DisplayFormat.Pieces(summary.Count)</MudText>
                    </div>
                </div>
                @if (summary.Holders.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="l2p-jewel-none">Zatím nikdo</MudText>
                }
                else
                {
                    <div class="l2p-jewel-holders">
                        @foreach (var holder in summary.Holders)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Variant="@(holder.Player.IsActive ? Variant.Filled : Variant.Outlined)"
                                     Href="@DisplayFormat.PlayerUrl(holder.Player.UserId)">@HolderText(holder)</MudChip>
                        }
                    </div>
                }
            </MudPaper>
        }
    </div>
}

@code {
    private readonly CancellationTokenSource _disposed = new();

    private IReadOnlyList<JewelTypeSummary>? _gallery;
    private bool _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private static string HolderText(JewelHolder holder)
    {
        var text = holder.Count > 1 ? $"{holder.Player.Nick} ×{holder.Count}" : holder.Player.Nick;
        return holder.Player.IsActive ? text : $"{text} (neaktivní)";
    }

    private async Task LoadAsync()
    {
        _error = false;
        try
        {
            _gallery = await JewelData.GetGalleryAsync(_disposed.Token);
        }
        catch (OperationCanceledException)
        {
            // The component was disposed while loading.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the jewel gallery failed");
            _gallery = null;
            _error = true;
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
