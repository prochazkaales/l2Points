@page "/jewels"
@using L2Points.Domain.Jewels
@using L2Points.Infrastructure.Services
@using L2Points.Web.Components.Jewels
@using L2Points.Web.Formatting
@inject JewelService JewelData
@inject ILogger<Jewels> Logger
@implements IDisposable

<PageTitle>Šperky – L2Points</PageTitle>

<PageHeader Title="Šperky">
    <AuthorizeView Roles="@Roles.Admin">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/admin/jewels"
                   StartIcon="@Icons.Material.Outlined.Edit">Upravit šperky</MudButton>
    </AuthorizeView>
</PageHeader>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">Šperky se nepodařilo načíst. Zkus to prosím znovu.</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">Zkusit znovu</MudButton>
}
else if (_gallery is null)
{
    <LoadingSkeleton />
}
else
{
    <MudText Typo="Typo.body2" Class="mb-3">@Summary(_gallery)</MudText>

    <div class="l2p-jewel-gallery">
        @foreach (var summary in _gallery)
        {
            var held = summary.Count > 0;
            @* Unheld types stay in place (catalog order) but step back, so the held ones stand out. *@
            <MudPaper Outlined="true" Class="@(held ? "l2p-tile l2p-jewel-card" : "l2p-tile l2p-jewel-card l2p-jewel-card-empty")">
                <div class="l2p-jewel-head">
                    <div class="l2p-jewel-big">
                        <JewelIcon Type="summary.Type" Size="64" Decorative="true" />
                    </div>
                    <div class="l2p-jewel-title">
                        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="l2p-jewel-name">@summary.Type.Name</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@(held ? DisplayFormat.Pieces(summary.Count) : "Zatím nikdo")</MudText>
                    </div>
                </div>
                @if (held)
                {
                    <div class="l2p-jewel-holders">
                        @foreach (var holder in summary.Holders)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Variant="@(holder.Player.IsActive ? Variant.Filled : Variant.Outlined)"
                                     Href="@DisplayFormat.PlayerUrl(holder.Player.UserId)">@HolderText(holder)</MudChip>
                        }
                    </div>
                }
            </MudPaper>
        }
    </div>
}

@code {
    private readonly CancellationTokenSource _disposed = new();

    private IReadOnlyList<JewelTypeSummary>? _gallery;
    private bool _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private static string Summary(IReadOnlyList<JewelTypeSummary> gallery) => DisplayFormat.JewelGallerySummary(
        gallery.Sum(s => s.Count),
        gallery.SelectMany(s => s.Holders).Select(h => h.Player.UserId).Distinct().Count(),
        gallery.Count(s => s.Count > 0),
        gallery.Count);

    private static string HolderText(JewelHolder holder)
    {
        var text = holder.Count > 1 ? $"{holder.Player.Nick} ×{holder.Count}" : holder.Player.Nick;
        return holder.Player.IsActive ? text : $"{text} (neaktivní)";
    }

    private async Task LoadAsync()
    {
        _error = false;
        try
        {
            _gallery = await JewelData.GetGalleryAsync(_disposed.Token);
        }
        catch (OperationCanceledException)
        {
            // The component was disposed while loading.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the jewel gallery failed");
            _gallery = null;
            _error = true;
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
