@using L2Points.Domain.Activities
@using L2Points.Domain.Attendances
@using L2Points.Domain.Time
@using L2Points.Web.Formatting

<div class="@RootClass">
    <table class="l2p-grid">
        <thead>
            <tr>
                <th class="l2p-grid-boss" scope="col">Boss</th>
                @foreach (var day in Days)
                {
                    <th scope="col" class="l2p-grid-day @DayClass(day)">
                        <span>@DisplayFormat.DayHeader(day)</span>
                        @if (IsLocked(day))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="l2p-grid-lock"
                                     Title="Den je zamčený" />
                        }
                        @if (day == Today)
                        {
                            <span class="l2p-today-pill">Dnes</span>
                        }
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var (group, index) in Groups.Select((g, i) => (g, i)))
            {
                <tr class="l2p-grid-group">
                    <th class="l2p-grid-boss" scope="rowgroup">
                        @foreach (var key in group.DotKeys)
                        {
                            <span class="@($"l2p-grid-dot l2p-grid-dot-{key}")" aria-hidden="true"></span>
                        }
                        @group.Title
                    </th>
                    @if (index == 0)
                    {
                        @* The dates are in the table header right above; empty cells (not one colspan) keep today's
                           column tint unbroken. *@
                        @foreach (var day in Days)
                        {
                            <td class="@(day == Today ? "l2p-grid-today" : null)"></td>
                        }
                    }
                    else
                    {
                        @* Repeat the dates on lower groups: on small screens the table header is scrolled out of view. *@
                        @foreach (var day in Days)
                        {
                            <th class="l2p-grid-group-day @DayClass(day)">@DisplayFormat.DayHeader(day)</th>
                        }
                    }
                </tr>
                @foreach (var row in group.Rows)
                {
                    var limitReached = AttendanceRules.IsWeeklyLimitReached(row.Activity, row.Cells.Count(c => c.IsChecked));
                    <tr>
                        <th class="l2p-grid-boss" scope="row">@row.Activity.Name</th>
                        @foreach (var day in Days)
                        {
                            <td class="l2p-grid-cell @DayClass(day)">
                                @foreach (var cell in row.Cells.Where(c => c.Date == day))
                                {
                                    @RenderCell(row.Activity, cell, limitReached)
                                }
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (ShowLegend)
{
    <ul class="l2p-grid-legend" aria-label="Legenda mřížky">
        <li><span class="l2p-legend-box l2p-legend-checked" aria-hidden="true"></span>zaškrtnuto</li>
        <li><span class="l2p-legend-box l2p-legend-unchecked" aria-hidden="true"></span>nezaškrtnuto</li>
        <li><span class="l2p-legend-box l2p-legend-locked" aria-hidden="true"></span>zaškrtnuto, nejde měnit</li>
        <li><span class="l2p-legend-box l2p-legend-blocked" aria-hidden="true"></span>nejde přidat (zamčený den, mimo rozpis, limit)</li>
        <li><span class="l2p-grid-dot l2p-grid-dot-evening" aria-hidden="true"></span>V – Večerní</li>
        <li><span class="l2p-grid-dot l2p-grid-dot-morning" aria-hidden="true"></span>R – Ranní</li>
    </ul>
}

@code {
    private static readonly (ActivityCategory Category, string Title, string[] DotKeys)[] GroupOrder =
    [
        (ActivityCategory.NormalEpic, "Normal epicy", ["normal"]),
        (ActivityCategory.ChaoticEpic, "Chaotic epicy", ["evening", "morning"]),
        (ActivityCategory.CastleSiege, "Castle Siege", ["cs"]),
    ];

    [Parameter, EditorRequired]
    public WeekGrid Grid { get; set; } = default!;

    /// <summary>All checkboxes are inert (drawn like normal cells, not dimmed) and no lock icons are shown.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>Current day in Prague; its column is highlighted. Optional.</summary>
    [Parameter]
    public DateOnly? Today { get; set; }

    /// <summary>Shows a short legend of the cell states under the grid.</summary>
    [Parameter]
    public bool ShowLegend { get; set; }

    [Parameter]
    public EventCallback<WeekGridCellToggle> OnToggle { get; set; }

    private IReadOnlyList<DateOnly> Days => Grid.Week.Days.ToList();

    private IEnumerable<(string Title, string[] DotKeys, IEnumerable<WeekGridRow> Rows)> Groups =>
        GroupOrder
            .Select(g => (g.Title, g.DotKeys, Rows: Grid.Rows.Where(r => r.Activity.Category == g.Category).ToList().AsEnumerable()))
            .Where(g => g.Rows.Any());

    private string RootClass => ReadOnly ? "l2p-grid-scroll l2p-glass l2p-grid-readonly" : "l2p-grid-scroll l2p-glass";

    private static string CheckClass(GridCellState state, WeekGridCell cell)
    {
        var css = "l2p-grid-check";
        if (state == GridCellState.Blocked)
        {
            css += " l2p-cell-blocked";
        }

        return cell.Slot switch
        {
            EventSlot.Evening => css + " l2p-slot-evening",
            EventSlot.Morning => css + " l2p-slot-morning",
            _ => css,
        };
    }

    private HashSet<DateOnly> _lockedDays = [];

    protected override void OnParametersSet() => _lockedDays = ComputeLockedDays();

    private string DayClass(DateOnly day) =>
        (day == Today ? "l2p-grid-today" : "") + (IsLocked(day) ? " l2p-grid-locked" : "");

    private bool IsLocked(DateOnly day) => _lockedDays.Contains(day);

    /// <summary>A day is locked when it has cells but none of them can be edited.</summary>
    private HashSet<DateOnly> ComputeLockedDays()
    {
        if (ReadOnly)
        {
            return [];
        }

        return Grid.Rows
            .SelectMany(r => r.Cells)
            .GroupBy(c => c.Date)
            .Where(g => g.All(c => !c.IsEditable))
            .Select(g => g.Key)
            .ToHashSet();
    }

    private static string? CellLabel(WeekGridCell cell)
    {
        if (cell.Slot == EventSlot.None)
        {
            return null;
        }

        var prefix = cell.Slot == EventSlot.Evening ? "V" : "R";
        return cell.TimeUtc is { } time
            ? $"{prefix} {AppTime.ToPragueTime(cell.Date, time):HH:mm}"
            : prefix;
    }

    private RenderFragment RenderCell(Activity activity, WeekGridCell cell, bool limitReached) => __builder =>
    {
        var label = CellLabel(cell);
        var ariaLabel = $"{activity.Name}, {DisplayFormat.DayHeader(cell.Date)}" + (label is null ? "" : $", {label}");
        // An unchecked cell outside the schedule cannot be added (the server rejects it); only removal is allowed.
        // The same holds once a flexible boss has its weekly count checked; it is computed from the shown state,
        // so it follows optimistic toggles without waiting for a reload.
        var blockedByLimit = limitReached && !cell.IsChecked;
        var state = GridCellStates.For(ReadOnly, cell, limitReached);
        var disabled = state != GridCellState.Editable;

        <div class="@CheckClass(state, cell)">
            @if (blockedByLimit && cell.IsEditable && !ReadOnly)
            {
                <MudTooltip Text="@($"Za týden už je zaškrtnuto {AttendanceRules.WeeklyLimit(activity)}×, víc výskytů se nečeká.")">
                    <MudCheckBox T="bool" Value="@cell.IsChecked" Label="@label" AriaLabel="@ariaLabel" Disabled="@disabled"
                                 Color="Color.Primary" Dense="true" />
                </MudTooltip>
            }
            else if (!cell.IsScheduled)
            {
                <MudTooltip Text="Mimo rozpis">
                    <MudCheckBox T="bool" Value="@cell.IsChecked" Label="@label" AriaLabel="@ariaLabel" Disabled="@disabled"
                                 Color="Color.Primary" Dense="true"
                                 ValueChanged="@(v => OnToggle.InvokeAsync(new WeekGridCellToggle(activity.Id, cell.Date, cell.Slot, v)))" />
                </MudTooltip>
            }
            else
            {
                <MudCheckBox T="bool" Value="@cell.IsChecked" Label="@label" AriaLabel="@ariaLabel" Disabled="@disabled"
                             Color="Color.Primary" Dense="true"
                             ValueChanged="@(v => OnToggle.InvokeAsync(new WeekGridCellToggle(activity.Id, cell.Date, cell.Slot, v)))" />
            }
        </div>
    };
}
