@using L2Points.Domain.Stats
@using L2Points.Web.Formatting

<MudPaper Outlined="true" Class="pa-4">
    <div class="l2p-summary-head">
        @if (!string.IsNullOrEmpty(Title))
        {
            <MudText Typo="Typo.subtitle1">@Title</MudText>
        }
        <div class="l2p-summary-points">
            <MudText Typo="Typo.h3" Color="Color.Primary" Class="l2p-summary-points-value">@Summary.Points</MudText>
            <MudText Typo="Typo.body2" Color="Color.Default">Body za týden</MudText>
        </div>
    </div>
    <div class="l2p-summary-grid">
        <div class="l2p-summary-tile l2p-summary-tile-total">
            <MudText Typo="Typo.caption" Color="Color.Default">Celkem</MudText>
            <MudText Typo="Typo.h5">@DisplayFormat.Percent(Summary.Stats.Total.Percent)</MudText>
            <MudText Typo="Typo.caption" Color="Color.Default">@Ratio(Summary.Stats.Total)</MudText>
        </div>
        @foreach (var category in Categories)
        {
            var stat = Summary.Stats[category];
            <div class="l2p-summary-tile">
                <MudText Typo="Typo.caption" Color="Color.Default">@DisplayFormat.CategoryLabel(category)</MudText>
                <MudText Typo="Typo.h5">@DisplayFormat.Percent(stat.Percent)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">@Ratio(stat)</MudText>
            </div>
        }
    </div>
</MudPaper>

@code {
    private static readonly StatCategory[] Categories =
        [StatCategory.Normal, StatCategory.Evening, StatCategory.Morning, StatCategory.CastleSiege];

    [Parameter, EditorRequired]
    public PlayerSummary Summary { get; set; } = default!;

    [Parameter]
    public string? Title { get; set; }

    private static string Ratio(CategoryStat stat) => $"{stat.Attended} / {stat.Expected}";
}
