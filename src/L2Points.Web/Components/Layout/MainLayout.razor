@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager
@inject IJSRuntime JS

@* Nothing renders until the theme is known, so the layout never paints once with the wrong palette; the static
   "Načítám…" placeholder from App.razor stays visible until .mud-layout exists. *@
@if (_themeReady)
{
    <MudThemeProvider Theme="AppTheme.Theme" @bind-IsDarkMode="_isDarkMode" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        @* Only below md: a thin bar that opens the drawer. From md up the drawer carries the brand and the user. *@
        <MudAppBar Elevation="0" Class="d-md-none">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           aria-label="Menu" OnClick="ToggleDrawer" />
            <AppLogo />
            <MudText Typo="Typo.h6" HtmlTag="span" Class="l2p-brand ml-2">L2Points</MudText>
        </MudAppBar>
        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Never"
                   Breakpoint="Breakpoint.Md">
            <div class="l2p-shell">
                <div class="l2p-shell-brand">
                    <AppLogo />
                    <span class="l2p-brand">L2Points</span>
                </div>
                <NavMenu />
                <div class="l2p-user-card">
                    <span class="l2p-avatar" aria-hidden="true">@Initial</span>
                    <div class="l2p-user-info">
                        <span class="l2p-user-nick">@_nick</span>
                        <span class="l2p-user-role">@_role</span>
                    </div>
                    <MudTooltip Text="@(_isDarkMode ? "Světlý režim" : "Tmavý režim")">
                        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                       Size="Size.Small" aria-label="Přepnout téma" OnClick="ToggleThemeAsync" />
                    </MudTooltip>
                    <form method="post" action="logout" class="l2p-logout-form">
                        <AntiforgeryToken />
                        <MudTooltip Text="Odhlásit se">
                            <MudIconButton Icon="@Icons.Material.Filled.Logout" Size="Size.Small"
                                           ButtonType="ButtonType.Submit" aria-label="Odhlásit se" />
                        </MudTooltip>
                    </form>
                </div>
            </div>
        </MudDrawer>
        <MudMainContent Class="l2p-main">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;
    // Dark is the fallback; the real value comes from the data-theme attribute set before first paint (l2pTheme.current).
    private bool _isDarkMode = true;
    // False until the theme is read: ComponentBase renders as soon as OnInitializedAsync yields, so without this the
    // first render would use the default (dark) palette while the JS call is in flight.
    private bool _themeReady;
    private string? _nick;
    private string? _role;

    private string Initial => string.IsNullOrEmpty(_nick) ? "" : _nick[..1].ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        // Prerender is off, so JS interop is available here.
        try
        {
            _isDarkMode = await JS.InvokeAsync<string>("l2pTheme.current") != "light";
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, the default stays.
        }
        catch (JSException)
        {
            // The script failed (e.g. theme.js not loaded), the default stays.
        }

        // Show the layout with the right palette now, not only after the nick query below.
        _themeReady = true;
        StateHasChanged();

        // The user name claim holds the login, so the display nick is read from the database.
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            var user = await UserManager.GetUserAsync(state.User);
            _nick = user?.Nick;
            // Only a label in the user card; access checks never read roles from here.
            _role = state.User.IsInRole(Roles.Admin) ? "Admin"
                : state.User.IsInRole(Roles.Reader) ? "Čtenář"
                : "Hráč";
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("l2pTheme.set", _isDarkMode ? "dark" : "light");
    }
}
